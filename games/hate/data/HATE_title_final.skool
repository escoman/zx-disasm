; code
c$5B8C LD HL,$E9F6   ; #REGhl=#N(59894,4,,1)($)
 $5B8F LD DE,$FFFF   ; #REGde=#N(65535,4,,1)($)
*$5B92 PUSH HL       ; Push #REGhl onto the stack
 $5B93 LD BC,$5FB3   ; #REGbc=#N(24499,4,,1)($)
 $5B96 OR A          ; Clear the carry flag and set the zero flag if #REGa=0
 $5B97 SBC HL,BC     ; #REGhl=#REGhl-carry-#REGbc
 $5B99 POP HL        ; Pop last item from stack into #REGhl
 $5B9A RET Z         ; Return if the zero flag is set
 $5B9B LD A,(HL)     ; #REGa=PEEK #REGhl
 $5B9C CP $97        ; Set the zero flag if #REGa=#N(151,2,,1)($), or the carry flag if #REGa<#N(151,2,,1)($)
 $5B9E JR Z,$5BA4    ; Jump to #R23460 if #REGa=#N(151,2,,1)($)
 $5BA0 LDD           ; POKE #REGde,PEEK #REGhl; #REGhl=#REGhl-1; #REGde=#REGde-1; #REGbc=#REGbc-1
 $5BA2 JR $5B92      ; Jump to #R23442
*$5BA4 DEC HL        ; #REGhl=#REGhl-1
 $5BA5 LD B,(HL)     ; #REGb=PEEK #REGhl
 $5BA6 BIT 7,B       ; Set the zero flag if bit 7 of #REGb is 0
 $5BA8 JR Z,$5BBA    ; Jump to #R23482 if bit 7 of #REGb is reset
 $5BAA RES 7,B       ; Reset bit 7 of #REGb
 $5BAC LD A,B        ; #REGa=#REGb
 $5BAD AND A         ; Clear the carry flag and set the zero flag if #REGa=0
 $5BAE JR Z,$5BBC    ; Jump to #R23484 if #REGa=0
 $5BB0 CP $03        ; Set the zero flag if #REGa=#N(3,2,,1)($), or the carry flag if #REGa<#N(3,2,,1)($)
 $5BB2 LD A,$00      ; #REGa=#N(0,2,,1)($)
 $5BB4 JR NC,$5BBC   ; Jump to #R23484 if the carry flag is not set
 $5BB6 LD A,$97      ; #REGa=#N(151,2,,1)($)
 $5BB8 JR $5BBC      ; Jump to #R23484
*$5BBA DEC HL        ; #REGhl=#REGhl-1
 $5BBB LD A,(HL)     ; #REGa=PEEK #REGhl
*$5BBC LD (DE),A     ; POKE #REGde,#REGa
 $5BBD DEC DE        ; #REGde=#REGde-1
 $5BBE DJNZ $5BBC    ; Decrement #REGb and jump to #R23484 if #REGb>0
 $5BC0 DEC HL        ; #REGhl=#REGhl-1
 $5BC1 JR $5B92      ; Jump to #R23442

